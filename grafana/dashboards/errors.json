{
  "uid": "json-storage-errors",
  "title": "json-storage / Errors",
  "timezone": "browser",
  "schemaVersion": 1,
  "version": 3,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["json-storage"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Client errors RPS (4xx)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=\"4xx\"}[1m])) or vector(0)",
          "legendFormat": "4xx rps"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server errors RPS (5xx)",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=\"5xx\"}[1m])) or vector(0)",
          "legendFormat": "5xx rps"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate % (4xx vs 5xx)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_requests_total{status=\"4xx\"}[5m])) / sum(rate(http_requests_total[5m])) or vector(0)",
          "legendFormat": "4xx %"
        },
        {
          "refId": "B",
          "expr": "(100 * sum(rate(http_requests_total{status=\"5xx\"}[5m])) / sum(rate(http_requests_total[5m]))) or vector(0)",
          "legendFormat": "5xx %"
        }
      ]
    }
  ]
}
