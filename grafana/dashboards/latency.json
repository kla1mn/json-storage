{
  "uid": "latency",
  "title": "json-storage / Latency",
  "timezone": "browser",
  "schemaVersion": 1,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["json-storage"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latency p50 milliseconds",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.50, sum by (le, method, handler) (rate(ns_json_storage_http_request_duration_seconds_bucket{handler=~\"^/ns/.*\", method!=\"OPTIONS\"}[5m])))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": []
          }
        },
        "overrides": []
      }
    },
    {
