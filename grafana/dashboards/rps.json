{
  "uid": "rps",
  "title": "json-storage / RPS",
  "timezone": "browser",
  "schemaVersion": 1,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["json-storage"],
  "templating": {
    "list": [
      {
        "name": "handler",
        "label": "Handler",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total{handler!=\"/metrics\",handler!=\"none\"}, handler)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS (total)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{handler!=\"/metrics\",handler!=\"none\"}[1m]))",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RPS by handler",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, handler) (rate(http_requests_total{handler=~\"$handler\",handler!=\"/metrics\",method!=\"OPTIONS\"}[1m]))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ]
    }
  ]
}
